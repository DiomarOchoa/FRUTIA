# ─────────────────────────────────────────────────────────────
# Frutia · variables de entorno
# Copia este archivo a .env y rellenalo.
# Modo $0 y local: Ollama + ComfyUI + Piper, sin claves de IA.
# ─────────────────────────────────────────────────────────────

# Clave del proyecto de Google AI Studio. Cubre guion, imagenes y voz.
# Se consigue gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Puerto de la API
PORT=4000

# Donde se guardan imagenes, audio y videos renderizados
STORAGE_DIR=./storage

# Proveedores locales.
# Instala Ollama y descarga el modelo con: ollama pull qwen2.5:3b
FRUTIA_LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
FRUTIA_OLLAMA_MODEL=qwen2.5:3b

# ComfyUI local y checkpoint Stable Diffusion 1.5 compatible.
FRUTIA_IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
FRUTIA_COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
FRUTIA_COMFYUI_TIMEOUT_MS=600000
FRUTIA_COMFYUI_STEPS=20

# Fuerza voz local para no llamar a proveedores externos.
FRUTIA_TTS_PROVIDER=piper

# Generaciones simultaneas. Subirlo por encima de 2 dispara los rate limits
# del free tier; bajalo si ves errores 429.
JOB_CONCURRENCY=2

# "production" obliga a aprobar cada plano antes de exportar.
# Dejalo fuera de .env durante el desarrollo para iterar rapido.
# NODE_ENV=production

# ─────────────────────────────────────────────────────────────
# Modelos (opcional)
#
# Google retira modelos con mucha rapidez, asi que Frutia prueba una lista de
# candidatos y cae al siguiente si el principal ya no existe. Solo hace falta
# tocar esto si los tres fallan.
#
# Para saber los nombres vigentes: https://ai.google.dev/gemini-api/docs/models
# ─────────────────────────────────────────────────────────────

# FRUTIA_LLM_MODEL=gemini-3.8-flash
# FRUTIA_IMAGE_MODEL=gemini-3.1-flash-image
# FRUTIA_TTS_MODEL=gemini-3.1-flash-tts-preview
# FRUTIA_VOICE=Puck

# Hugging Face Inference Providers (opcional; el uso puede tener costo)
# Crea un token con permiso "Make calls to Inference Providers" en:
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_...
# FRUTIA_HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# FRUTIA_HF_TIMEOUT_MS=180000

# Proveedor de imagenes: "auto" usa Google, HF si HF_TOKEN está configurado y
# Pollinations como último respaldo; "huggingface" fuerza el motor HF.
# FRUTIA_IMAGE_PROVIDER=auto

# ─────────────────────────────────────────────────────────────
# Piper TTS (motor de voz local, el respaldo final)
#
# Corre en tu computadora. Gratis, sin internet, sin limite.
# Se usa cuando Google (429), Pollinations (402) y Edge (403) fallan.
#
# Instalar motor:  pip install piper-tts
# Voz (ya incluida en la carpeta voces/):
#   https://huggingface.co/rhasspy/piper-voices/tree/main/es
#
# Ejecutable y modelo locales. Las rutas relativas se evalúan desde apps/api.
# PIPER_BIN=C:\Users\TU_USUARIO\AppData\Local\Programs\Python\Python313\Scripts\piper.exe
# PIPER_MODEL=../../voces/es_MX-claude-high.onnx
#
# Edge TTS: poner EDGE_TTS=0 para desactivarlo (Microsoft lo bloquea
# fuera del navegador con un 403).
# EDGE_TTS=0

# ─────────────────────────────────────────────────────────────
# Pollinations (respaldo opcional de imagenes)
#
# Se usa si Google agota su cuota. La API exige clave secreta de servidor y
# descuenta saldo Pollen; un saldo insuficiente devuelve error sin reintentos.
#
# Crear clave: https://enter.pollinations.ai/keys
# Revisa saldo y costos en la cuenta antes de usar este respaldo.
#
# POLLINATIONS_API_KEY=sk_...
